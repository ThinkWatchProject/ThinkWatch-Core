{
  "reply-language": {
    "manifest": {
      "api": 1,
      "description": "Adds a fixed line to the end of the system prompt that asks the model to answer in the language set here.",
      "hooks": {
        "reply_text": false,
        "reply_text_end": false,
        "request": true,
        "tool_call": false
      },
      "name": "Answer in a chosen language",
      "permissions": [
        "system"
      ],
      "reply_mode": "block",
      "requests": [
        "conversation"
      ],
      "scope": {
        "clients": [],
        "models": [],
        "upstreams": []
      },
      "settings": [
        {
          "default": "简体中文",
          "key": "language",
          "kind": "string",
          "label": "Answer language"
        }
      ]
    },
    "sha256": "a519a1c406641a7f18e71f6cb522a586ef85ed096b05429969ed5fac1569edf1"
  },
  "wsl-paths": {
    "manifest": {
      "api": 1,
      "description": "Rewrites drive paths in tool-call arguments to the form the client can open (WSL /mnt/c/… or Windows C:\\…), in answers and in the conversation history.",
      "hooks": {
        "reply_text": false,
        "reply_text_end": false,
        "request": true,
        "tool_call": true
      },
      "name": "Convert WSL and Windows paths",
      "permissions": [
        "messages",
        "reply_tool_calls"
      ],
      "reply_mode": "block",
      "requests": [
        "conversation"
      ],
      "scope": {
        "clients": [],
        "models": [],
        "upstreams": []
      },
      "settings": [
        {
          "default": false,
          "key": "windows_client",
          "kind": "boolean",
          "label": "The client runs on Windows (otherwise WSL)"
        }
      ]
    },
    "sha256": "6140347e0898d022dc3dd92d7f48b9a380b58e1c42e7fc001008591dde9f9edf"
  }
}
