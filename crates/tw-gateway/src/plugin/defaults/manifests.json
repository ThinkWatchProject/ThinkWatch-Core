{
  "reply-language": {
    "manifest": {
      "api": 1,
      "description": "Adds a fixed line to the end of the system prompt that asks the model to answer in the language set here.",
      "hooks": {
        "reply_text": false,
        "reply_text_end": false,
        "request": true,
        "tool_call": false
      },
      "name": "Answer in a chosen language",
      "on_error": "reject",
      "permissions": [
        "system"
      ],
      "reply_mode": "block",
      "requests": [
        "conversation"
      ],
      "scope": {
        "clients": [],
        "models": [],
        "upstreams": []
      },
      "settings": [
        {
          "key": "language",
          "kind": "string",
          "label": "Answer language",
          "value": "简体中文"
        }
      ]
    },
    "sha256": "f34e95b9db72c98eadac320f7c3f7af9acb8beae9fa3acd8eda1d0459e18bb6e"
  },
  "wsl-paths": {
    "manifest": {
      "api": 1,
      "description": "Rewrites drive paths in tool-call arguments to the form the client can open (WSL /mnt/c/… or Windows C:\\…), in answers and in the conversation history.",
      "hooks": {
        "reply_text": false,
        "reply_text_end": false,
        "request": true,
        "tool_call": true
      },
      "name": "Convert WSL and Windows paths",
      "on_error": "reject",
      "permissions": [
        "messages",
        "reply_tool_calls"
      ],
      "reply_mode": "block",
      "requests": [
        "conversation"
      ],
      "scope": {
        "clients": [],
        "models": [],
        "upstreams": []
      },
      "settings": [
        {
          "key": "windows_client",
          "kind": "boolean",
          "label": "The client runs on Windows (otherwise WSL)",
          "value": false
        }
      ]
    },
    "sha256": "6aaf3646438f024a6482413eca7fe9f17230d3f5177458476d070485cb333a99"
  }
}
